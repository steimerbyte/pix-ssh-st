{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@xynogen/pix-runtime": ["./node_modules/@xynogen/pix-runtime/src/index.ts"],
			"@xynogen/pix-runtime/collapse": ["./node_modules/@xynogen/pix-runtime/src/collapse.ts"],
			"@xynogen/pix-pretty/ansi": ["./node_modules/@xynogen/pix-pretty/src/ansi.ts"],
			"@xynogen/pix-pretty/config": ["./node_modules/@xynogen/pix-pretty/src/config.ts"],
			"@xynogen/pix-pretty/gate-overlay": ["./node_modules/@xynogen/pix-pretty/src/gate-overlay.ts"],
			"@xynogen/pix-pretty/icon-catalog": ["./node_modules/@xynogen/pix-pretty/src/icon-catalog.ts"],
			"@xynogen/pix-pretty/renderers": ["./node_modules/@xynogen/pix-pretty/src/renderers.ts"],
			"@xynogen/pix-pretty/types": ["./node_modules/@xynogen/pix-pretty/src/types.ts"],
			"@xynogen/pix-pretty/utils": ["./node_modules/@xynogen/pix-pretty/src/utils.ts"],
			"@xynogen/pix-pretty/widget-format": ["./node_modules/@xynogen/pix-pretty/src/widget-format.ts"]
		},
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*.ts"]
}
