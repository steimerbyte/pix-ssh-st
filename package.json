{
	"name": "@steimerbyte/pix-ssh-st",
	"version": "0.2.5",
	"description": "Pi tool — ssh_run with fork policy: approve once per session (non-privileged) + 30-min rolling window for sudo commands.",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"test": "bun test",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:@earendil-works/* --external:node:* --outfile=dist/index.js",
		"watch": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:@earendil-works/* --external:node:* --outfile=dist/index.js --watch"
	},
	"files": [
		"src",
		"dist",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/index.js"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"ssh",
		"sudo",
		"remote"
	],
	"author": "steimerbyte",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steimerbyte/pix-ssh-st.git"
	},
	"bugs": {
		"url": "https://github.com/steimerbyte/pix-ssh-st/issues"
	},
	"homepage": "https://github.com/steimerbyte/pix-ssh-st#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.25.0",
		"@xynogen/pix-runtime": "^0.8.0",
		"typebox": "^1.1.38"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"esbuild": "^0.28.2"
	}
}