{
	"name": "@steimerbyte/pix-ssh-st",
	"version": "0.1.0",
	"description": "Pi tool — ssh_run with fork policy: approve once per session (non-privileged) + 30-min rolling window for sudo commands.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"ssh",
		"sudo",
		"remote"
	],
	"author": "steimerbyte",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steimerbyte/pix-ssh-st.git"
	},
	"bugs": {
		"url": "https://github.com/steimerbyte/pix-ssh-st/issues"
	},
	"homepage": "https://github.com/steimerbyte/pix-ssh-st#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"typebox": "^1.1.38",
		"@xynogen/pix-pretty": "^1.25.0",
		"@xynogen/pix-runtime": "^0.8.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
